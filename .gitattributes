# This file guarantees that every text file is normalized to LF line endings
# in the repo, and will be converted to platform native line endings on checkout.
*                text=auto
*.yaml           text
*.txt            text
*.sh             text
*.plist          text
*.md             text
*.json           text
*.cfg            text
.gitignore       text
.gitattributes   text

# Preserve the upstream trust bundle bytes verified by its pinned SHA-256.
rust/crates/processors/data/certifi/cacert.pem -text

# Keep third-party license files byte-for-byte, so `cargo xtask licenses --check`
# matches the published crates on every checkout.
rust/licenses/** -text
