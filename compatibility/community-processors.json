    "MozillaURLProvider": {
      "description": {
        "display": "Provides URL to the latest Firefox release."
      },
      "input_variables": [
        [
          "product_name",
          [
            [
              "required",
              {
                "display": "True"
              }
            ],
            [
              "description",
              {
                "display": "Product to fetch URL for. One of: 'firefox', 'firefox-esr', 'firefox-beta', 'firefox-nightly', 'thunderbird', 'thunderbird-beta'."
              }
            ]
          ]
        ],
        [
          "release",
          [
            [
              "required",
              {
                "display": "False"
              }
            ],
            [
              "default",
              {
                "display": "latest"
              }
            ],
            [
              "description",
              {
                "display": "Which release to download. Examples: 'latest', 79.0"
              }
            ]
          ]
        ],
        [
          "locale",
          [
            [
              "required",
              {
                "display": "False"
              }
            ],
            [
              "default",
              {
                "display": "en-US"
              }
            ],
            [
              "description",
              {
                "display": "Which localization to download, default is 'en-US'."
              }
            ]
          ]
        ],
        [
          "platform",
          [
            [
              "required",
              {
                "display": "False"
              }
            ],
            [
              "default",
              {
                "display": "osx"
              }
            ],
            [
              "description",
              {
                "display": "Which platform/OS to download: 'osx' (default), 'linux', 'linux64', 'win', 'win64'."
              }
            ]
          ]
        ],
        [
          "base_url",
          [
            [
              "required",
              {
                "display": "False"
              }
            ],
            [
              "description",
              {
                "display": "(Advanced) URL for downloads.  Default is 'https://download.mozilla.org/?product={product_release}-ssl&os={platform}&lang={locale}'."
              }
            ],
            [
              "default",
              {
                "display": "https://download.mozilla.org/?product={product_release}-ssl&os={platform}&lang={locale}"
              }
            ]
          ]
        ],
        [
          "versions_base_url",
          [
            [
              "required",
              {
                "display": "False"
              }
            ],
            [
              "description",
              {
                "display": "(Advanced) URL for product release version information.  Default is 'https://product-details.mozilla.org/1.0/{product}_versions.json'."
              }
            ],
            [
              "default",
              {
                "display": "https://product-details.mozilla.org/1.0/{product}_versions.json"
              }
            ]
          ]
        ]
      ],
      "output_variables": [
        [
          "url",
          [
            [
              "description",
              {
                "display": "URL to the latest Mozilla product release."
              }
            ]
          ]
        ],
        [
          "moz_version",
          [
            [
              "description",
              {
                "display": "Resolved version number for a release normalized to a 3 or 4 digit semantic version. For example:  'latest-beta' -> 79.0b9 -> 79.0.0.9"
              }
            ]
          ]
        ],
        [
          "moz_original_version",
          [
            [
              "description",
              {
                "display": "Pre-normalized version number from the product versions information."
              }
            ]
          ]
        ]
      ]
    },
